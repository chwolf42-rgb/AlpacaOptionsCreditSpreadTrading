# AlpacaOptionsCreditSpreadTrading — paper credentials for THIS repo only.
# Do not reuse AlpacaTradingBots (equity) or AlpacaCryptoTrading keys.
# A dedicated Alpaca paper account (~$100k when keyed) is expected.
#
# Precedence: OPTIONS_APCA_* overrides inherited APCA_*.
# The process fails closed if keys are missing, the URL is live,
# or the resolved key matches EQUITY_APCA_API_KEY_ID / CRYPTO_APCA_API_KEY_ID.

# --- Required for live paper data / orders (observer still places zero orders) ---
OPTIONS_APCA_API_KEY_ID=
OPTIONS_APCA_API_SECRET_KEY=

# Paper trading API (required). Live https://api.alpaca.markets is refused.
OPTIONS_APCA_API_BASE_URL=https://paper-api.alpaca.markets

# Market data (stock bars + option snapshots). Default Alpaca data host.
OPTIONS_APCA_DATA_URL=https://data.alpaca.markets

# Optional: refuse to start if GET /v2/account number does not match.
# OPTIONS_APCA_EXPECTED_ACCOUNT_NUMBER=
# APCA_EXPECTED_ACCOUNT_NUMBER=

# Inherited Alpaca names (used only when OPTIONS_APCA_* are unset).
# Prefer OPTIONS_APCA_* so this bot cannot silently pick up a sibling .env.
# APCA_API_KEY_ID=
# APCA_API_SECRET_KEY=
# APCA_API_BASE_URL=https://paper-api.alpaca.markets

# Sibling keys — isolation guard. If set, this process refuses to start
# when the resolved OPTIONS/APCA key equals either of these.
# EQUITY_APCA_API_KEY_ID=
# CRYPTO_APCA_API_KEY_ID=
